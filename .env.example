# ai-web2api 环境变量示例（复制为 .env 后按需修改）
# 说明：配置以 config.yaml 为准；本文件只列**真正生效**的覆盖项。
# 生效范围见 config.apply_env_overrides / main.py 的 load_dotenv。

# ── 浏览器 / 登录 ────────────────────────────────────
# 可选：自动登录凭据（不配置则用 /admin/{provider}/login/start 手动登录一次）
# DEEPSEEK_USERNAME=13800000000
# DEEPSEEK_PASSWORD=your-password
# QWEN_USERNAME=your@email.com
# QWEN_PASSWORD=your-password

# 浏览器是否无头（覆盖 config.yaml 的 browser.headless）
# 优先级：WEB2API_HEADLESS > DEEPSEEK_HEADLESS（<PROVIDER>_HEADLESS）> config.yaml
# 需要看得见窗口手动登录时设 false（Docker 下无窗口，请改用 cookies 导入）：
# WEB2API_HEADLESS=false

# ── API 鉴权（可选）────────────────────────────────────
# 设置后所有 /v1/* 请求需带 Authorization: Bearer <key>；支持逗号分隔多个 key
# WEB2API_API_KEY=your-secret-key

# ── 服务地址 / 数据目录 ───────────────────────────────
# host / port / profiles_dir 请直接改 config.yaml（.env 不覆盖这几项，
# 避免“换 config 文件启动”时仍被 .env 里的端口霸占）。
# Docker Compose 额外支持 WEB2API_PUBLISH_PORT 控制宿主映射端口（见 docker-compose.yml）。

# ── 配置文件位置（可选）───────────────────────────────
# AI_WEB2API_CONFIG=config.yaml
