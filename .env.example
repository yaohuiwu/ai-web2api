# ai-web2api 配置示例（复制为 .env 后按需修改）
# 所有变量也支持以环境变量方式设置（前缀 WEB2API_）

# ── 服务 ─────────────────────────────────────────────
# 激活的 provider: deepseek | mock
WEB2API_PROVIDER=deepseek
WEB2API_HOST=127.0.0.1
WEB2API_PORT=8000
# 网关鉴权 key（可选，设置后所有 /v1/* 请求需带 Authorization: Bearer <key>）
# WEB2API_API_KEY=your-secret-key
# 登录态/浏览器 profile 存放目录
# WEB2API_DATA_DIR=~/.web2api
WEB2API_LOG_LEVEL=info

# ── DeepSeek 网页 provider ────────────────────────────
# 可选：自动登录凭据（不配置则用 `web2api login deepseek` 手动登录一次）
# DEEPSEEK_USERNAME=13800000000
# DEEPSEEK_PASSWORD=your-password
# 服务运行时浏览器是否无头
# DEEPSEEK_HEADLESS=true
# 单次回复等待超时（秒）
# DEEPSEEK_TIMEOUT=120
